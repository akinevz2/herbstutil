{
  "name": "herbstutil",
  "version": "0.2.0",
  "description": "A simple filter to print herbstclient attr output in machine-readable format.",
  "author": "Kirill <kine> Nevzorov",
  "email": "akinevz@outlook.com",
  "license": "GPL-2.0-only",
  "homepage": "https://github.com/akinevz2/herbstutil",
  "bin": {
    "herbstutil": "./dist/index"
  },
  "files": [
    "src/",
    "tests/",
    "LICENSE",
    "README.md",
    "tsconfig.json",
    "bunli.config.ts",
    ".bunli/"
  ],
  "type": "module",
  "keywords": [
    "herbstluftwm",
    "window-manager",
    "tiling",
    "linux",
    "utility",
    "json",
    "herbstclient",
    "cli",
    "bash",
    "wm",
    "configuration"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/akinevz2/herbstutil.git"
  },
  "bugs": {
    "url": "https://github.com/akinevz2/herbstutil/issues"
  },
  "scripts": {
    "postinstall": "bunli generate",
    "build": "bunli build",
    "compile": "bun run build",
    "test": "bun test",
    "typecheck": "tsgo --noEmit",
    "completion:install": "bun scripts/completion.ts install",
    "completion:uninstall": "bun scripts/completion.ts uninstall",
    "completion:print": "bun scripts/completion.ts print"
  },
  "dependencies": {
    "@bunli/core": "latest"
  },
  "devDependencies": {
    "@bunli/test": "latest",
    "@tsconfig/bun": "1.0.10",
    "@types/bun": "latest",
    "bunli": "latest",
    "typescript": "^5.0.0"
  },
  "bunli": {
    "entry": "./src/index.ts",
    "outDir": "./dist"
  }
}
