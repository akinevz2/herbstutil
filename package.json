{
  "name": "herbstutil",
  "version": "0.1.1a",
  "description": "A utility to convert herbstclient attribute output into JSON. Perfect for programmatically interacting with the herbstluftwm tiling window manager.",
  "author": "akinevz",
  "license": "GPL-2.0-only",
  "homepage": "https://github.com/akinevz/herbstutil",
  "bin": {
    "herbstutil": "./dist/index"
  },
  "type": "module",
  "keywords": [
    "herbstluftwm",
    "window-manager",
    "tiling",
    "linux",
    "utility",
    "json",
    "herbstclient",
    "cli",
    "bash",
    "wm",
    "configuration"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/akinevz2/herbstutil.git"
  },
  "bugs": {
    "url": "https://github.com/akinevz2/herbstutil/issues"
  },
  "scripts": {
    "postinstall": "bunli generate",
    "build": "bunli build",
    "compile": "bun run build",
    "test": "bun test",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@bunli/core": "latest"
  },
  "devDependencies": {
    "@bunli/test": "latest",
    "@tsconfig/bun": "1.0.10",
    "@types/bun": "latest",
    "bunli": "latest",
    "typescript": "^5.0.0"
  },
  "bunli": {
    "entry": "./src/index.ts",
    "outDir": "./dist"
  }
}